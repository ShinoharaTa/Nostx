{
	"name": "Nostx",
	"short_name": "Nostx",
	"description": "Redirect to Nostr items in Your Apps.",
	"start_url": "/",
	"display": "standalone",
	"theme_color": "#101010",
	"background_color": "#101010",
	"icons": [
		{
			"src": "/image/app_icon_192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/image/app_icon_512.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	],
	"share_target": {
		"action": "/share",
		"method": "GET",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url"
		}
	}
}
